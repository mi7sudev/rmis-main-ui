# ============================================================================
# RMIS — Environment Configuration Template
# ============================================================================
# Copy this file to `.env` and fill in the values for your environment.
# The same file format works on both:
#   • Localhost development  (bun run dev)
#   • Intranet production     (bun run start, NODE_ENV=production)
#
# Only the VALUES differ — see DEPLOYMENT.md for the full setup guide.
# This template is SAFE to commit (no real secrets).
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE_URL — SQLite connection string (always starts with `file:`).
#
# Localhost dev:
#   DATABASE_URL=file:/home/you/projects/rmis/db/production-data.db
#   (or a relative path from the project root:)
#   DATABASE_URL=file:./db/production-data.db
#
# Intranet production:
#   DATABASE_URL=file:/opt/rmis/db/production-data.db
#   (use an absolute path on the server so it doesn't depend on CWD)
# ----------------------------------------------------------------------------
DATABASE_URL=file:./db/production-data.db

# ----------------------------------------------------------------------------
# NEXTAUTH_SECRET — Secret used to sign JWT session tokens (HS256).
#   • Must be ≥ 16 characters.
#   • Generate a strong random secret:
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   • Use a DIFFERENT secret on localhost vs. the intranet server.
#   • Rotating this secret invalidates all active sessions (users must re-login).
# ----------------------------------------------------------------------------
NEXTAUTH_SECRET=replace-with-a-strong-random-secret-at-least-16-chars

# ----------------------------------------------------------------------------
# NEXTAUTH_URL — Canonical public URL of the deployed app (no trailing slash).
#   • Localhost dev:   http://localhost:3000
#   • Intranet prod:   the EXACT URL employees type, e.g.
#                        http://10.10.120.X          (Caddy/nginx proxy on 80)
#                        http://10.10.120.X:3000     (direct, no proxy)
#                      or https://... if TLS is terminated by a reverse proxy.
#   • Must match the address bar exactly (scheme + host + optional port) or
#     login sessions won't stick.
# ----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# UPLOAD_DIR — Absolute path to the directory where applicant documents are stored.
#   • Leave empty (or comment out) to use the default: <project-root>/upload
#   • On the intranet server, set this to a persistent volume so uploads
#     survive app redeployments:
#       UPLOAD_DIR=/var/data/rmis/uploads
#   • On localhost dev, leave empty.
# ----------------------------------------------------------------------------
# UPLOAD_DIR=/var/data/rmis/uploads

# ----------------------------------------------------------------------------
# AI / Document Intelligence — powers PDS auto-extract (VLM/LLM).
# Uses NVIDIA's OpenAI-compatible API (https://integrate.api.nvidia.com/v1).
# Get a free API key at: https://build.nvidia.com  (sign in → "Get API Key")
#   • Same key works on localhost AND the intranet server.
#   • If AI_API_KEY is unset, the app still starts but PDS auto-extract fails.
# ----------------------------------------------------------------------------
AI_API_KEY=nvapi-your-nvidia-api-key-here

# Base URL of the OpenAI-compatible AI API. Default: NVIDIA integrate endpoint.
# Override only if you're using a different provider (e.g. OpenAI, Together AI).
# AI_BASE_URL=https://integrate.api.nvidia.com/v1

# Models — defaults are tuned for Philippine PDS extraction:
#   • AI_TEXT_MODEL   — chat/instruct model that structures extracted text → JSON
#   • AI_VISION_MODEL — vision-language model that reads images & returns JSON
# Override only if you want to use different models from the NVIDIA catalog.
# AI_TEXT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# AI_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# ----------------------------------------------------------------------------
# NODE_ENV — Set automatically by Next.js. Do NOT set this manually.
#   • `bun run dev`   → development
#   • `bun run start` → production
# ----------------------------------------------------------------------------


# ============================================================================
# Two-tier access control (public web vs intranet staff)
# See src/lib/access-tier.ts and DEPLOYMENT.md §"Two-Tier Access Topology".
# ============================================================================
# "on" (default) — ADMIN/EVALUATOR logins, sessions and APIs only work from
# intranet IPs (private/loopback, or the proxy-vouched address). Applicants
# work from any network. "off" disables all tier checks (emergency switch).
INTRANET_ENFORCEMENT=on
# Extra IPv4 CIDRs always treated as intranet — allowlist an office egress IP
# behind NAT or an admin VPN range. Comma-separated. Examples:
# INTRANET_CIDRS=203.0.113.7/32
# INTRANET_CIDRS=198.51.100.0/24,192.0.2.99/32
