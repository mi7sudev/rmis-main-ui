# ============================================================================
# RMIS — PUBLIC WEB reverse proxy (Caddy)
#
# Purpose: expose the APPLICANT-FACING system to the internet like a real
# production website — landing page, jobs board, sign-up, applicant sign-in
# and the applicant portal — at https://rmis.mirdc.example.ph (your domain).
#
# ADMIN + EVALUATOR access is NOT exposed here: the application itself
# refuses staff logins, staff sessions and every staff API from requests
# that arrive through this (public) path — see src/lib/access-tier.ts.
# Staff (IT officials) use the intranet proxy instead:
# deploy/Caddyfile.intranet (http://10.10.120.X on the office LAN).
#
# Both proxies point at the SAME app instance on 127.0.0.1:3000 — one
# deployment serves both tiers; the network tier is enforced in the app.
#
# Install (Debian/Ubuntu):
#   sudo apt install -y debian-keyring debian-archive-keyring apt-transport-https
#   curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
#   curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-stable.list
#   sudo apt update && sudo apt install caddy
#
# 1) Point the domain's DNS A/AAAA record at this server's PUBLIC IP.
# 2) Copy this file to /etc/caddy/Caddyfile, replace the domain, then:
#   sudo systemctl reload caddy
#
# Caddy obtains and renews the public TLS certificate automatically
# (HTTP-01 challenge) — ports 80 AND 443 must be reachable from the internet.
#
# SECURITY NOTES
#   · header_up X-Forwarded-For {remote_host} OVERWRITES any client-supplied
#     chain with the one address this proxy vouches for. Do NOT change it to
#     an append-style directive — the app's intranet guard trusts exactly
#     this address, and overwriting is what makes spoofing impossible.
#   · With TLS in front, the app turns on Secure session cookies
#     automatically (x-forwarded-proto: https) — no code change needed.
# ============================================================================

rmis.mirdc.example.ph {
	# Allow PDS / certificate uploads (app limit is 10 MB per file).
	request_body {
		max_size 12MB
	}

	# HSTS — public HTTPS site, force secure transport for returning visitors.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Serve long-lived static assets with caching headers (Next.js already
	# fingerprints them — same policy as the intranet proxy).
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /var/log/caddy/rmis-public.log
	}
}

# HTTP→HTTPS redirect is automatic (Caddy serves the challenge + redirect on :80).
