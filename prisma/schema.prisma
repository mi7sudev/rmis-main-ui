/// Polymorphic relation table — maps files to ANY linked content row.
/// Column names use `related_*` (not `morph_*`) per the production DB.
/// `order` is a SQL reserved word — Prisma field is `order` with @map("order").
model FileRelatedLink {
  id         Int    @id @default(autoincrement()) @map("id")
  fileId     Int?    @map("file_id")
  relatedId  Int?    @map("related_id")
  relatedType String? @map("related_type")
  field      String? @map("field")
  order      Float?  @map("order")

  @@index([fileId], map: "files_related_mph_file_fk")
  @@index([relatedId, relatedType], map: "files_related_mph_morph_fk")
  @@map("files_related_mph")
}

