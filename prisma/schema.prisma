// Outbound email audit trail. Every send (real or mock)
// lands here so admins can audit exactly what was sent to whom, and the
// shortlist email is provable even in the mock dev driver.
model EmailLog {
  id          Int      @id @default(autoincrement())
  to          String
  subject     String
  bodyText    String   @map("body_text")
  bodyHtml    String?  @map("body_html")
  provider    String
  /// "sent" | "failed" | "mock" | "skipped"
  status      String
  providerRef String?  @map("provider_ref")
  error       String?
  relatedType String?  @map("related_type")
  relatedId   Int?     @map("related_id")
  /// JSON metadata of sent attachments: [{ name, bytes }] — content is NEVER
  /// persisted here (only the provider receives the actual file bytes).
  attachments String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("email_logs")
}
