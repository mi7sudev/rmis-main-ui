// ============================================================================
// RMIS — Recruitment Management Information System (DOST-MIRDC)
// Prisma schema mapping EXACTLY to the RMIS production SQLite database
// (db/production-data.db) — the database is owned and accessed 100% by this
// Next.js app via Prisma.
//
// IMPORTANT — READ BEFORE EDITING:
//   * This schema is a PURE MAPPING. NEVER run `prisma db push` or migrations
//     against the production DB — it would destroy real data.
//   * Every model uses `@@map("table_name")` to map to the physical table.
//   * Every field uses `@map("column_name")` to map to the physical column.
//   * Legacy junction tables (`*_lnk`) are modelled as explicit join models (no Prisma
//     `@relation` declarations) because they carry extra `*_ord` columns that
//     Prisma's implicit m2m cannot represent.
//   * DATE columns stored as TEXT ("1993-07-25") are typed as `String?`.
//   * DATETIME columns stored as epoch milliseconds are typed as `DateTime?`.
//   * JSON-typed SQLite columns are declared as `Unsupported("json")?`.
//     DEVIATION from the task spec: Prisma 6.11's SQLite connector cannot
//     deserialize SQLite `json`-declared columns — it throws
//     "Conversion failed: Value json not supported" whenever a query returns
//     a row with NULL in such a column. `Unsupported` makes Prisma skip the
//     column entirely, so `findMany` works for all rows. To READ a json
//     column's value, use `db.$queryRaw` (see `src/lib/raw-json.ts` helper).
//     This matches the original Prisma introspection's choice.
//   * `govt_id_date_issued` and `govt_id_valid_until` are varchar → `String?`.
//   * Internal framework housekeeping tables (admin_*, strapi_*, i18n_locale,
//     sqlite_sequence) are intentionally excluded — the app does not need them.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SECTION 1 — AUTH & USERS
// ============================================================================

/// Users table (`up_users`) — legacy RMIS user accounts.
model User {
  id                  Int       @id @default(autoincrement()) @map("id")
  documentId          String?   @map("document_id")
  username            String?   @map("username")
  email               String?   @map("email")
  provider            String?   @map("provider")
  password            String?   @map("password")
  resetPasswordToken  String?   @map("reset_password_token")
  confirmationToken   String?   @map("confirmation_token")
  confirmed           Boolean?  @map("confirmed")
  blocked             Boolean?  @map("blocked")
  createdAt           DateTime? @map("created_at")
  updatedAt           DateTime? @map("updated_at")
  publishedAt         DateTime? @map("published_at")
  createdById         Int?      @map("created_by_id")
  updatedById         Int?      @map("updated_by_id")
  locale              String?   @map("locale")
  isAdmin             Boolean?  @map("is_admin")
  isApplicant         Boolean?  @map("is_applicant")
  firstName           String?   @map("first_name")
  middleName          String?   @map("middle_name")
  lastName            String?   @map("last_name")
  otp                 String?   @map("otp")
  encryptedId         String?   @map("encrypted_id")
  noOfAttempts        Int?      @map("no_of_attemps")
  informationFillouted Boolean?  @map("information_fillouted")

  @@index([createdById], map: "up_users_created_by_id_fk")
  @@index([updatedById], map: "up_users_updated_by_id_fk")
  @@index([documentId, locale, publishedAt], map: "up_users_documents_idx")
  @@map("up_users")
}

