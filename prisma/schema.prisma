  nickname                  String?   @map("nickname")
  mobileNumber              BigInt?   @map("mobile_number")
  contactNumber             String?   @map("contact_number")
  telephoneNumber           String?   @map("telephone_number")
  publication               String?   @map("publication")
  birthDate                 String?   @map("birth_date")
  birthPlace                String?   @map("birth_place")
  emailAddress              String?   @map("email_address")
  gender                    String?   @map("gender")
  civilStatus               String?   @map("civil_status")
  citizenship               String?   @map("citizenship")
  naturalized               String?   @map("naturalized")
  height                    String?   @map("height")
  weight                    String?   @map("weight")
  bloodType                 String?   @map("blood_type")
  createdAt                 DateTime? @map("created_at")
  updatedAt                 DateTime? @map("updated_at")
  publishedAt               DateTime? @map("published_at")
  createdById               Int?      @map("created_by_id")
  updatedById               Int?      @map("updated_by_id")
  locale                    String?   @map("locale")
  pagibig                   String?   @map("pagibig")
  gsis                      String?   @map("gsis")
  philhealth                String?   @map("philhealth")
  tin                       String?   @map("tin")
  sss                       String?   @map("sss")
  govtIssuedId              String?   @map("govt_issued_id")
  govtIdIssuedNumber        String?   @map("govt_id_issued_number")
  govtIdIssuedPlace         String?   @map("govt_id_issued_place")
  govtIdDateIssued          String?   @map("govt_id_date_issued")
  govtIdValidUntil          String?   @map("govt_id_valid_until")
  houseNumber               String?   @map("house_number")
  street                    String?   @map("street")
  subdivision               String?   @map("subdivision")
  barangay                  String?   @map("barangay")
  city                      String?   @map("city")
  province                  String?   @map("province")
  country                   String?   @map("country")
  permanentHouseNumber      String?   @map("permanent_house_number")
  permanentStreet           String?   @map("permanent_street")
  permanentSubdivision      String?   @map("permanent_subdivision")
  permanentBarangay         String?   @map("permanent_barangay")
  permanentCity             String?   @map("permanent_city")
  permanentProvince         String?   @map("permanent_province")
  permanentCountry          String?   @map("permanent_country")
  permanentTelephoneNumber  String?   @map("permanent_telephone_number")
  imagePath                 String?   @map("image_path")
  applicationLetterPath     String?   @map("application_letter_path")
  pdsPath                   String?   @map("pds_path")
  employmentCertificatePath String?   @map("employment_certificate_path")
  torPath                   String?   @map("tor_path")
  coePath                   String?   @map("coe_path")
  trainingCertificatePath   String?   @map("training_certificate_path")
  infoSheetPath             String?   @map("info_sheet_path")
  curriculumVitaePath       String?   @map("curriculum_vitae_path")
  performancePath           String?   @map("performance_path")
  wexpPath                  String?   @map("wexp_path")
  pendingCases              String?   @map("pending_cases")
  specifyReferral           String?   @map("specify_referral")
  remarks                   String?   @map("remarks")
  qualified                 Boolean?  @map("qualified")
  zipCode                   String?   @map("zip_code")
  permanentZipCode          String?   @map("permanent_zip_code")
  employeeId                String?   @map("employee_id")
  statusOfEployment         String?   @map("status_of_eployment")
  submittedDate             DateTime? @map("submitted_date")
  institution               Boolean?  @map("institution")
  applicationStatus         Boolean?  @map("application_status")
  placeOfBirth              String?   @map("place_of_birth")
  isPwd                     Boolean?  @map("is_pwd")
  isGovernment              Boolean?  @map("is_government")
  respondentTo              String?   @map("respondent_to")
  religion                  String?   @map("religion")
  presentAddress            String?   @map("present_address")
  ethnicity                 String?   @map("ethnicity")
